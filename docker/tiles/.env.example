# Copy to .env in this folder. docker compose reads it for docker-compose.yml.

# The go-pmtiles release that does the extract. v1.31.2 was published 2026-07-22.
PMTILES_IMAGE_TAG=v1.31.2

# The planet build to cut from. Protomaps publishes one most days and keeps a selection of
# older ones: pick a recent one from https://maps.protomaps.com/builds/. It must be basemap
# tiles version 4, which @protomaps/basemaps 5.x (vendored in public_html/vendor) draws.
TILES_SOURCE_URL=https://build.protomaps.com/20261008.pmtiles

# The region, matching docker/valhalla and docker/photon: a file name, and the box
# (min_lon,min_lat,max_lon,max_lat) to cut. Utah at full detail (zoom 15) is about 290 MB.
# Waypoint's MAP_TILES_PATH must name the result: storage/maps/utah.pmtiles.
TILES_REGION=utah
TILES_BBOX=-114.06,36.99,-109.03,42.01
