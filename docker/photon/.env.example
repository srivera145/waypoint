# Copy to .env in this folder. docker compose reads it for docker-compose.yml.

# The Photon release the image is built from, and the SHA-256 of its jar as the GitHub release
# lists it. 1.3.0 was published 2026-08-07, and Waypoint's tests ran against it. Change both
# together. A new major version also needs a reimport: set PHOTON_FORCE_REIMPORT=True once.
PHOTON_VERSION=1.3.0
PHOTON_SHA256=a89707c0045e4807b2a1180e132e68e108d998709f48b6c94b98a6e281f571a5

# The region, matching docker/valhalla: a short name for its folder, the GraphHopper Photon
# dump that covers it, and the box (min_lon,min_lat,max_lon,max_lat) of places to keep from
# that dump. Utah for development: the box around Utah, the area of the Geofabrik extract
# Valhalla builds from, cut out of the USA dump.
PHOTON_REGION=utah
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/north-america/usa/photon-dump-usa-1.0-latest.jsonl.zst
PHOTON_BBOX=-114.06,36.99,-109.03,42.01
# For the whole US, keep the dump and drop the box:
#   PHOTON_REGION=us
#   PHOTON_BBOX=

# Languages to import names in, comma-separated. The first is also the default for answers.
PHOTON_LANGUAGES=en

# Host address and port. 127.0.0.1 keeps Photon off the network. Waypoint's PHOTON_URL must
# match (http://127.0.0.1:2322).
PHOTON_BIND=127.0.0.1
PHOTON_PORT=2322

# Java heap and import threads. 2 GB is plenty for Utah; the whole US wants 8 GB or more.
PHOTON_JAVA_OPTS=-Xmx2g
PHOTON_THREADS=2

# True rebuilds the region's database from the dump on disk at the next start. Set it back to
# False afterwards.
PHOTON_FORCE_REIMPORT=False

# Leave unset for a Docker named volume (fastest, and the right choice on Windows).
# Set to a folder such as ./data to see the files on the host.
# PHOTON_DATA=./data
