# Copy to .env in this folder. docker compose reads it for docker-compose.yml.

# The valhalla-scripted image tag. 3.9.0 was published 2026-09-19. Waypoint's tests ran
# against 3.9.0. Changing it means rebuilding tiles: set VALHALLA_FORCE_REBUILD=True once.
VALHALLA_IMAGE_TAG=3.9.0

# Where to download OpenStreetMap data from, and a short name for the folder it builds in.
# Start with one state for development. For the whole US, change both:
#   VALHALLA_REGION=us
#   VALHALLA_PBF_URL=https://download.geofabrik.de/north-america/us-latest.osm.pbf
VALHALLA_REGION=utah
VALHALLA_PBF_URL=https://download.geofabrik.de/north-america/us/utah-latest.osm.pbf

# Host address and port. 127.0.0.1 keeps Valhalla off the network; Waypoint's VALHALLA_URL
# must match (http://127.0.0.1:8002).
VALHALLA_BIND=127.0.0.1
VALHALLA_PORT=8002

# Build and serve threads. Lower it if the build is killed for running out of memory.
VALHALLA_THREADS=4

# True rebuilds the region's tiles on the next start. Set it back to False afterwards.
VALHALLA_FORCE_REBUILD=False

# Leave unset for a Docker named volume (fastest, and the right choice on Windows).
# Set to a folder such as ./custom_files to see the files on the host.
# VALHALLA_DATA=./custom_files
