APP_NAME="Waypoint"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://waypoint.local
APP_REPO_URL=
APP_LICENSE=TODO
MULTI_TENANCY_ENABLED=false
FILESYSTEM_DISK=local
FILESYSTEM_MAX_UPLOAD_MB=10
FILESYSTEM_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,heic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waypoint
DB_USERNAME=root
DB_PASSWORD=

# otp | magic_link | both
AUTH_METHOD=both

# Mail configuration
# smtp | log
# - smtp (default): real email delivery via configured SMTP provider.
# - log: write outgoing mail to storage/logs/mail.log (useful for local dev before SMTP is set up).
#   In log mode, request an OTP or magic link and read the code/URL from that file.
MAIL_MAILER=smtp

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Waypoint"

# Routing. Valhalla runs in Docker from docker/valhalla (see its README); the PBF it builds
# from is set in docker/valhalla/.env. Timeouts are seconds. ROUTING_PROVIDER names the
# RoutingProvider to use: only valhalla exists today.
ROUTING_PROVIDER=valhalla
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_CONNECT_TIMEOUT=3
VALHALLA_TIMEOUT=20
ROUTING_CACHE_TTL_MINUTES=10
ROUTING_RATE_LIMIT_PER_MINUTE=20

# Place search. Photon runs from docker/photon (see its README), built for the same region as
# Valhalla. Timeouts are seconds and kept short: this answers a search box as the user types.
# GEOCODING_PROVIDER names the GeocodingProvider to use: only photon exists today. Identical
# searches are cached per user for PLACES_CACHE_TTL_MINUTES.
GEOCODING_PROVIDER=photon
PHOTON_URL=http://127.0.0.1:2322
PHOTON_CONNECT_TIMEOUT=2
PHOTON_TIMEOUT=5
PHOTON_LANGUAGE=en
PLACES_CACHE_TTL_MINUTES=5
PLACES_RATE_LIMIT_PER_MINUTE=60

# The basemap: one Protomaps .pmtiles archive (docker/README.md says how to get one).
# Waypoint serves MAP_TILES_PATH itself at /tiles/basemap.pmtiles, with range requests; a
# relative path is from the project root. Set MAP_TILES_URL instead to load the archive from a
# static server or CDN that answers range requests, which is the better choice in production.
MAP_TILES_PATH=storage/maps/utah.pmtiles
MAP_TILES_URL=
