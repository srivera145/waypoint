APP_ENV=testing
APP_DEBUG=false
APP_URL=http://localhost
MULTI_TENANCY_ENABLED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waypoint
DB_DATABASE_TEST=waypoint_test
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

AUTH_METHOD=both
MAIL_MAILER=log

STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_feature_test

# The Integration suite talks to this Valhalla and skips itself when nothing answers.
ROUTING_PROVIDER=valhalla
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_CONNECT_TIMEOUT=3
VALHALLA_TIMEOUT=30

# Feature tests swap in a fake geocoder; nothing here is contacted.
GEOCODING_PROVIDER=photon
PHOTON_URL=http://127.0.0.1:2322
PHOTON_CONNECT_TIMEOUT=2
PHOTON_TIMEOUT=5
MAP_TILES_PATH=
MAP_TILES_URL=
